# 环境变量模板 —— 复制成 .env.local 再填自己的值
#   cp .env.example .env.local
#
# 注意：.env / .env.* 已在 .gitignore 里，绝不会被提交。

# ── 存储模式 ───────────────────────────────────────────────
# 不填这两项 → 本地文件模式（数据在 ~/.work-manager/work.db）
# 填了这两项 → 云端 libSQL 模式（进程无状态，服务器上不留数据文件）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── 访问口令 ───────────────────────────────────────────────
# 不填则用内置默认口令 workbuddy-2026，正式上线请务必改掉
ACCESS_PASSWORD=

# ── 其它 ──────────────────────────────────────────────────
# PORT          服务端口（多数平台会自动注入，不用手填）
# DATA_DIR      本地模式的数据目录，默认 ~/.work-manager
# DB_PATH       本地模式直接指定库文件路径（隔离测试用）
